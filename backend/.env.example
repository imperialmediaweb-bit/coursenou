# ---------------------------------------------------------------------------
# Coursbit — backend environment
#
# Only DATABASE_URL is strictly required to boot. Everything else switches a
# feature on: without an AI key courses fall back to template content, without
# SMTP no email is sent (and the server logs loudly that it skipped), and each
# payment provider is inactive until its keys are present.
# ---------------------------------------------------------------------------

# Database (PostgreSQL). Railway provides this automatically.
DATABASE_URL=postgresql://user:password@host:5432/railway

# Server
PORT=3001
NODE_ENV=production

# Public URL of the site. Used for links in emails and payment redirects —
# password reset is unusable if this is wrong.
FRONTEND_URL=https://coursbit.com

# ---------------------------------------------------------------------------
# Auth
# If unset, stable secrets are derived from DATABASE_URL so sessions survive a
# redeploy. Set them explicitly in production.
# ---------------------------------------------------------------------------
JWT_SECRET=your-very-long-random-secret-here-minimum-64-characters-for-security
JWT_REFRESH_SECRET=another-very-long-random-secret-here-minimum-64-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# AI providers — at least one is needed for real course content.
# Tried in order: the user's chosen provider, then OpenAI, Gemini, Claude.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=your-gemini-api-key
CLAUDE_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Lesson images — tried in this order, then a neutral placeholder.
# ---------------------------------------------------------------------------
PIXABAY_API_KEY=your-pixabay-key
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
# Generating images with DALL-E costs money per image; off unless set to true.
USE_DALLE_IMAGES=false

# ---------------------------------------------------------------------------
# Email (SMTP). Without these, no email is sent at all — including password
# resets. The server logs every skipped message so it is never silent.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Leave unset to infer from the port (465 = implicit TLS, otherwise STARTTLS).
SMTP_SECURE=
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=noreply@coursbit.com
SMTP_FROM_NAME=Coursbit
# Where contact-form submissions are delivered. Falls back to SMTP_FROM_EMAIL.
CONTACT_NOTIFY_EMAIL=owner@coursbit.com

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# ---------------------------------------------------------------------------
# PayPal
# PAYPAL_WEBHOOK_ID is required: without it every PayPal webhook is rejected,
# because it is what proves an incoming event genuinely came from PayPal.
# Find it under Developer Dashboard > Apps & Credentials > Webhooks.
# ---------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=live
PAYPAL_MONTHLY_PLAN_ID=P-...
PAYPAL_YEARLY_PLAN_ID=P-...
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# ---------------------------------------------------------------------------
# Razorpay (charges in INR)
# Set the rupee amounts for your market; they are not derived from the USD
# price. Defaults: 899/month, 6999/year.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_MONTHLY_INR=899
RAZORPAY_YEARLY_INR=6999

# ---------------------------------------------------------------------------
# Paystack (charges in NGN)
# Naira amounts for your market. Defaults: 15000/month, 119000/year.
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_MONTHLY_NGN=15000
PAYSTACK_YEARLY_NGN=119000

# ---------------------------------------------------------------------------
# Rate limits — optional. Defaults shown; raise only if you know why.
#   GLOBAL   requests per IP per 15 min across the API
#   AUTH     failed logins per IP per 15 min (successful ones never count)
#   REGISTER accounts created per IP per hour
#   AI       course/quiz/flashcard generations per user per hour
# ---------------------------------------------------------------------------
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_REGISTER_MAX=15
RATE_LIMIT_AI_MAX=120

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@coursbit.com
