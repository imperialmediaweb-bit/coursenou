# MongoDB
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/ai-courses

# Server
PORT=3001
NODE_ENV=production

# JWT
JWT_SECRET=your-very-long-random-secret-here-minimum-64-characters-for-security
JWT_REFRESH_SECRET=another-very-long-random-secret-here-minimum-64-characters-for-security
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Providers
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Unsplash (for course images)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=live
PAYPAL_MONTHLY_PLAN_ID=P-...
PAYPAL_YEARLY_PLAN_ID=P-...

# Razorpay
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Paystack
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_MONTHLY_PLAN_CODE=PLN_...
PAYSTACK_YEARLY_PLAN_CODE=PLN_...

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=CourseBit

# URLs
FRONTEND_URL=https://your-frontend.railway.app
BACKEND_URL=https://your-backend.railway.app

# Admin
ADMIN_EMAIL=admin@yourdomain.com
